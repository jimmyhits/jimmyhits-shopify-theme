{%- comment -%}
  Jimmy Hits homepage hero: three portrait photos side by side with a button on top.
  Desktop: three equal columns. Mobile: swipeable row.
  Each photo can be swapped in the theme editor; if left empty it falls back to the
  photo bundled with the theme (assets/jh-hero-*.jpg).
{%- endcomment -%}
{%- liquid
  assign fallbacks = 'jh-hero-wall.jpg,jh-hero-cathedral.jpg,jh-hero-plaza.jpg' | split: ','
-%}

{%- style -%}
  #HeroTriptych-{{ section.id }} {
    position: relative;
    overflow: hidden;
  }
  #HeroTriptych-{{ section.id }} .hero-triptych__track {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ section.settings.gap }}px;
  }
  #HeroTriptych-{{ section.id }} .hero-triptych__item {
    position: relative;
    aspect-ratio: 2 / 3;
    max-height: {{ section.settings.max_height }}vh;
    overflow: hidden;
    margin: 0;
  }
  #HeroTriptych-{{ section.id }} .hero-triptych__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
  }
  #HeroTriptych-{{ section.id }} .hero-triptych__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }}) 0%, rgba(0, 0, 0, 0) 45%);
  }
  #HeroTriptych-{{ section.id }} .hero-triptych__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6rem;
    display: flex;
    justify-content: center;
    padding: 0 2rem;
    z-index: 1;
  }
  @media screen and (max-width: 749px) {
    #HeroTriptych-{{ section.id }} .hero-triptych__track {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    #HeroTriptych-{{ section.id }} .hero-triptych__track::-webkit-scrollbar {
      display: none;
    }
    #HeroTriptych-{{ section.id }} .hero-triptych__item {
      flex: 0 0 82%;
      max-height: none;
      scroll-snap-align: center;
    }
    #HeroTriptych-{{ section.id }} .hero-triptych__content {
      bottom: 3.5rem;
    }
  }
{%- endstyle -%}

<div id="HeroTriptych-{{ section.id }}" class="hero-triptych color-{{ section.settings.color_scheme }} gradient">
  <div class="hero-triptych__track" aria-label="{{ section.settings.accessibility_label | escape }}">
    {%- for i in (1..3) -%}
      {%- liquid
        assign key = 'image_' | append: i
        assign img = section.settings[key]
        assign idx = i | minus: 1
        if forloop.first
          assign loading = 'eager'
        else
          assign loading = 'lazy'
        endif
      -%}
      <figure class="hero-triptych__item">
        {%- if img != blank -%}
          {%- if forloop.first -%}
            {{ img | image_url: width: 1500 | image_tag: widths: '400, 600, 800, 1000, 1200, 1500', sizes: '(min-width: 750px) 34vw, 82vw', loading: 'eager', fetchpriority: 'high', alt: img.alt }}
          {%- else -%}
            {{ img | image_url: width: 1500 | image_tag: widths: '400, 600, 800, 1000, 1200, 1500', sizes: '(min-width: 750px) 34vw, 82vw', loading: 'lazy', alt: img.alt }}
          {%- endif -%}
        {%- else -%}
          <img
            src="{{ fallbacks[idx] | asset_url }}"
            alt="Jimmy Hits"
            width="1000"
            height="1500"
            loading="{{ loading }}"
            {% if forloop.first %}fetchpriority="high"{% endif %}
          >
        {%- endif -%}
      </figure>
    {%- endfor -%}
  </div>
  <div class="hero-triptych__overlay"></div>
  {%- if section.settings.button_label != blank -%}
    <div class="hero-triptych__content">
      <a
        {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
        class="button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
        {% if section.settings.button_link contains 'http' %}target="_blank" rel="noopener"{% endif %}
      >
        {{- section.settings.button_label | escape -}}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Hero: 3 photos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Photo 1 (left)",
      "info": "Leave empty to use the Madrid wall photo"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Photo 2 (middle)",
      "info": "Leave empty to use the Madrid cathedral photo"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Photo 3 (right)",
      "info": "Leave empty to use the Madrid plaza photo"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Listen Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "label": "Outline button style",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Bottom shade",
      "default": 45
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 16,
      "step": 2,
      "unit": "px",
      "label": "Gap between photos",
      "default": 0
    },
    {
      "type": "range",
      "id": "max_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Max height on desktop",
      "default": 90
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Photos of Jimmy Hits"
    }
  ],
  "presets": [
    {
      "name": "Hero: 3 photos"
    }
  ]
}
{% endschema %}

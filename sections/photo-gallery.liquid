{%- comment -%}
  Jimmy Hits photo gallery: a row of portrait photos (4 across on desktop, 2 on mobile).
  Each block can use an uploaded image, or fall back to a photo bundled with the theme
  (assets/<file name>).
{%- endcomment -%}
{%- style -%}
  #PhotoGallery-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #PhotoGallery-{{ section.id }} .photo-gallery__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.gap }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #PhotoGallery-{{ section.id }} .photo-gallery__item {
    position: relative;
    aspect-ratio: {{ section.settings.aspect_ratio }};
    overflow: hidden;
    margin: 0;
  }
  #PhotoGallery-{{ section.id }} .photo-gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  @media (hover: hover) {
    #PhotoGallery-{{ section.id }} .photo-gallery__item:hover img {
      transform: scale(1.03);
    }
  }
  #PhotoGallery-{{ section.id }} .photo-gallery__heading {
    text-align: center;
    margin: 0 0 3rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  @media screen and (max-width: 749px) {
    #PhotoGallery-{{ section.id }} .photo-gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{%- endstyle -%}

<div id="PhotoGallery-{{ section.id }}" class="photo-gallery color-{{ section.settings.color_scheme }} gradient">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="photo-gallery__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="photo-gallery__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="photo-gallery__item" {{ block.shopify_attributes }} style="--pos: {{ block.settings.focus }};">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '300, 450, 600, 800, 1000, 1200', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy', alt: block.settings.alt, style: 'object-position: var(--pos);' }}
          {%- elsif block.settings.asset_file != blank -%}
            <img
              src="{{ block.settings.asset_file | asset_url }}"
              alt="{{ block.settings.alt | escape }}"
              loading="lazy"
              width="1000"
              height="1250"
              style="object-position: var(--pos);"
            >
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Photo gallery",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Photos per row (desktop)",
      "default": 4
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Photo shape",
      "options": [
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "2 / 3", "label": "Tall 2:3" },
        { "value": "1 / 1", "label": "Square" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Gap between photos",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "asset_file",
          "label": "Bundled photo file (used if no photo is picked)",
          "info": "Advanced: file name in the theme's assets folder"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Description (for screen readers and Google)",
          "default": "Jimmy Hits"
        },
        {
          "type": "select",
          "id": "focus",
          "label": "Crop focus",
          "options": [
            { "value": "center top", "label": "Top" },
            { "value": "center 30%", "label": "Upper" },
            { "value": "center center", "label": "Center" },
            { "value": "center bottom", "label": "Bottom" }
          ],
          "default": "center 30%"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Photo gallery",
      "blocks": [{ "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" }]
    }
  ]
}
{% endschema %}
